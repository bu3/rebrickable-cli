# Delete default set (cleanup - may not exist)
exec cli user sets delete -n 10274-1
stdout 'Calling URL'
! stderr .

# Delete default set (cleanup - may not exist)
exec cli user sets delete -n 10274
stdout 'Calling URL'
! stderr .

# Get sets
exec cli user sets get
stdout '"count": 0,'
! stderr .


# Add default set
exec cli user sets set -n 10274
stdout 'Set saved'
! stderr .

# Get sets and should contain 1 set only
exec cli user sets get
stdout '"count": 1,'
! stderr .