# Cleanup (may not exist)
exec cli user sets delete -n 10274-1
stdout '(Deleted set|not found)'
! stderr .

exec cli user sets delete -n 10274
stdout '(Deleted set|not found)'
! stderr .

exec cli user sets delete -n 10497
stdout '(Deleted set|not found)'
! stderr .

# Add default set
exec cli user sets set -n 10274
stdout 'Set saved'
! stderr .

# Get sets and verify our set is present
exec cli user sets get
stdout '"set_num": "10274-1"'
! stderr .
